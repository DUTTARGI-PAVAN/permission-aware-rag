# Application Settings
PROJECT_NAME="Permission-Aware RAG System"
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# PostgreSQL Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=permission_rag

# Database URL (asyncpg for SQLAlchemy async operations)
# In Docker, POSTGRES_SERVER should be 'db'
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/permission_rag

# Database Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

